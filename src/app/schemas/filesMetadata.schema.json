{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "array",
    "items": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "stats": {
          "type": "object",
          "properties": {
            "size": {
              "type": "number"
            },
            "mtime": {
              "type": "string",
              "format": "date-time"
            },
            "isDirectory": {
              "type": "boolean"
            }
          },
          "required": [
            "size",
            "mtime",
            "isDirectory"
          ]
        }
      },
      "required": [
        "path",
        "stats"
      ]
    }
  }
}